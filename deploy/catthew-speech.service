[Unit]
Description=Catthew local English speech recognition and synthesis
After=network.target

[Service]
Type=simple
DynamicUser=yes
WorkingDirectory=/opt/catthew-speech/app
ExecStart=/opt/catthew-speech/venv/bin/python -m hub.speech_server --whisper-model /opt/catthew-speech/models-joe/whisper --voice-model /opt/catthew-speech/models-joe/voices/en/en_US/joe/medium/en_US-joe-medium.onnx
Environment=OMP_NUM_THREADS=2
Environment=OPENBLAS_NUM_THREADS=1
Environment=HF_HUB_OFFLINE=1
Environment=PYTHONDONTWRITEBYTECODE=1
CacheDirectory=catthew-speech
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
MemoryMax=768M
MemorySwapMax=128M
CPUQuota=150%
Restart=on-failure
RestartSec=5
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
