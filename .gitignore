.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
hub/.venv/

# Rebuildable reel frames and intermediate audio.
promo/

# Session dumps from the coding agent, never the product.
agent-tools/

# Secrets and local config
.env
.env.*
secrets/
*.pem


# OS
.DS_Store
*~
